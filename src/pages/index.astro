---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import ContactForm from "../components/ContactForm.astro";
import { Image } from "astro:assets";
import UnalLogo from "../assets/img/universidad-nacional.png";
---

<BaseLayout>
    <main id="main">
        <span id="top"></span>

        <!-- ============ HERO SECTION ============ -->
        <HeroSection />
        <!-- ============ SERVICIOS (CURVED OVERLAP SECTION HALLTEC STYLE) ============ -->
        <section class="section--curved-top" id="servicios">
            <div class="container">
                <!-- Tarjetas Destacadas Halltec Style -->
                <div class="hall-cards-grid reveal">
                    <div class="hall-card">
                        <div class="hall-card__icon hall-card__icon--purple">
                            <svg viewBox="0 0 24 24">
                                <path d="M16 18l6-6-6-6M8 6l-6 6 6 6"></path>
                            </svg>
                        </div>
                        <div>
                            <h3>Software a la medida</h3>
                            <p>
                                ERPs, CRMs y sistemas internos para tu proceso
                                real.
                            </p>
                        </div>
                    </div>

                    <div class="hall-card">
                        <div class="hall-card__icon hall-card__icon--teal">
                            <svg viewBox="0 0 24 24">
                                <path
                                    d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"
                                ></path>
                            </svg>
                        </div>
                        <div>
                            <h3>Plataformas SaaS</h3>
                            <p>
                                Productos digitales en la nube con suscripciones
                                y facturación.
                            </p>
                        </div>
                    </div>

                    <div class="hall-card">
                        <div class="hall-card__icon hall-card__icon--violet">
                            <svg viewBox="0 0 24 24">
                                <circle cx="9" cy="20" r="1.6"></circle>
                                <circle cx="18" cy="20" r="1.6"></circle>
                                <path
                                    d="M2 3h3l2.6 12.4a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.6L21.5 7H6"
                                ></path>
                            </svg>
                        </div>
                        <div>
                            <h3>E-commerce</h3>
                            <p>
                                Tiendas online con pago e inventario
                                sincronizado.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Fila 2 de Tarjetas Destacadas -->
                <div class="hall-cards-grid reveal" style="--d: 120ms">
                    <div class="hall-card">
                        <div class="hall-card__icon hall-card__icon--emerald">
                            <svg viewBox="0 0 24 24">
                                <path
                                    d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
                                ></path>
                                <path
                                    d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
                                ></path>
                            </svg>
                        </div>
                        <div>
                            <h3>Integraciones & APIs</h3>
                            <p>
                                Conexión con facturación electrónica, ERPs,
                                pasarelas de pago y WhatsApp.
                            </p>
                        </div>
                    </div>

                    <div class="hall-card">
                        <div class="hall-card__icon hall-card__icon--amber">
                            <svg viewBox="0 0 24 24">
                                <rect x="2" y="3" width="6" height="6" rx="1"
                                ></rect>
                                <rect x="16" y="3" width="6" height="6" rx="1"
                                ></rect>
                                <rect x="9" y="15" width="6" height="6" rx="1"
                                ></rect>
                                <path
                                    d="M5 9v3a2 2 0 0 0 2 2h2m10-5v3a2 2 0 0 1-2 2h-2"
                                ></path>
                            </svg>
                        </div>
                        <div>
                            <h3>Automatización de procesos</h3>
                            <p>
                                Flujos operacionales y tareas repetitivas para
                                conectar tus herramientas.
                            </p>
                        </div>
                    </div>

                    <div class="hall-card">
                        <div class="hall-card__icon hall-card__icon--rose">
                            <svg viewBox="0 0 24 24">
                                <path
                                    d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                                ></path>
                                <path d="M9 12l2 2 4-4"></path>
                            </svg>
                        </div>
                        <div>
                            <h3>Soporte & Evolución</h3>
                            <p>
                                Monitoreo continuo, mejoras mensuales y
                                disponibilidad garantizada.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ============ LOGOS / EXPERIENCIA DEL EQUIPO ============ -->
        <section class="clients">
            <div class="container">
                <div class="clients__header">
                    <h2 class="clients__label">
                        Marcas e instituciones que respaldan la trayectoria de
                        nuestro equipo
                    </h2>
                    <p class="clients__sublabel">
                        Organizaciones en las que nuestros ingenieros y
                        especialistas han colaborado en proyectos clave
                    </p>
                </div>
                <div
                    class="marquee"
                    aria-label="Carrusel de organizaciones con trayectoria de nuestro equipo"
                >
                    <div class="marquee__track">
                        <!-- Bloque 1 -->
                        <div
                            class="client-logo"
                            title="Universidad Nacional de Colombia"
                            data-tooltip="Universidad Nacional de Colombia"
                        >
                            <Image
                                alt="Universidad Nacional de Colombia"
                                src={UnalLogo}
                            />
                        </div>
                        <div
                            class="client-logo"
                            title="Ministerio de las Culturas, las Artes y los Saberes"
                            data-tooltip="Ministerio de las Culturas, las Artes y los Saberes"
                        >
                            <img
                                src="/src/assets/img/culturas.png"
                                alt="Ministerio de las Culturas, las Artes y los Saberes"
                                loading="lazy"
                            />
                        </div>
                        <div
                            class="client-logo"
                            title="Gobernación de Antioquia"
                            data-tooltip="Gobernación de Antioquia"
                        >
                            <img
                                src="/src/assets/img/gobernacion-antioquia.png"
                                alt="Gobernación de Antioquia"
                                loading="lazy"
                            />
                        </div>
                        <div
                            class="client-logo"
                            title="Corporación Gilberto Echeverri Mejía"
                            data-tooltip="Corporación Gilberto Echeverri Mejía"
                        >
                            <img
                                src="/src/assets/img/corpo-gem.png"
                                alt="Corporación Gilberto Echeverri Mejía"
                                loading="lazy"
                            />
                        </div>
                        <div
                            class="client-logo"
                            title="Ricaurte Rosso Seguros"
                            data-tooltip="Ricaurte Rosso Seguros"
                        >
                            <img
                                src="/src/assets/img/logo-c.jpg"
                                alt="Ricaurte Rosso Seguros"
                                loading="lazy"
                            />
                        </div>
                        <div
                            class="client-logo client-logo--dark"
                            title="BINAR10 CORP"
                            data-tooltip="BINAR10 CORP"
                        >
                            <img
                                src="/src/assets/img/binar.png"
                                alt="BINAR10 CORP"
                                loading="lazy"
                            />
                        </div>

                        <!-- Bloque 2 -->
                        <div
                            class="client-logo"
                            title="Universidad Nacional de Colombia"
                            data-tooltip="Universidad Nacional de Colombia"
                        >
                            <img
                                src="/src/assets/img/universidad-nacional.png"
                                alt="Universidad Nacional de Colombia"
                                loading="lazy"
                            />
                        </div>
                        <div
                            class="client-logo"
                            title="Ministerio de las Culturas, las Artes y los Saberes"
                            data-tooltip="Ministerio de las Culturas, las Artes y los Saberes"
                        >
                            <img
                                src="/src/assets/img/culturas.png"
                                alt="Ministerio de las Culturas, las Artes y los Saberes"
                                loading="lazy"
                            />
                        </div>
                        <div
                            class="client-logo"
                            title="Gobernación de Antioquia"
                            data-tooltip="Gobernación de Antioquia"
                        >
                            <img
                                src="/src/assets/img/gobernacion-antioquia.png"
                                alt="Gobernación de Antioquia"
                                loading="lazy"
                            />
                        </div>
                        <div
                            class="client-logo"
                            title="Corporación Gilberto Echeverri Mejía"
                            data-tooltip="Corporación Gilberto Echeverri Mejía"
                        >
                            <img
                                src="/src/assets/img/corpo-gem.png"
                                alt="Corporación Gilberto Echeverri Mejía"
                                loading="lazy"
                            />
                        </div>
                        <div
                            class="client-logo"
                            title="Ricaurte Rosso Seguros"
                            data-tooltip="Ricaurte Rosso Seguros"
                        >
                            <img
                                src="/src/assets/img/logo-c.jpg"
                                alt="Ricaurte Rosso Seguros"
                                loading="lazy"
                            />
                        </div>
                        <div
                            class="client-logo client-logo--dark"
                            title="BINAR10 CORP"
                            data-tooltip="BINAR10 CORP"
                        >
                            <img
                                src="/src/assets/img/binar.png"
                                alt="BINAR10 CORP"
                                loading="lazy"
                            />
                        </div>

                        <!-- Bloque 3 -->
                        <div
                            class="client-logo"
                            title="Universidad Nacional de Colombia"
                            data-tooltip="Universidad Nacional de Colombia"
                        >
                            <img
                                src="/src/assets/img/universidad-nacional.png"
                                alt="Universidad Nacional de Colombia"
                                loading="lazy"
                            />
                        </div>
                        <div
                            class="client-logo"
                            title="Ministerio de las Culturas, las Artes y los Saberes"
                            data-tooltip="Ministerio de las Culturas, las Artes y los Saberes"
                        >
                            <img
                                src="/src/assets/img/culturas.png"
                                alt="Ministerio de las Culturas, las Artes y los Saberes"
                                loading="lazy"
                            />
                        </div>
                        <div
                            class="client-logo"
                            title="Gobernación de Antioquia"
                            data-tooltip="Gobernación de Antioquia"
                        >
                            <img
                                src="/src/assets/img/gobernacion-antioquia.png"
                                alt="Gobernación de Antioquia"
                                loading="lazy"
                            />
                        </div>
                        <div
                            class="client-logo"
                            title="Corporación Gilberto Echeverri Mejía"
                            data-tooltip="Corporación Gilberto Echeverri Mejía"
                        >
                            <img
                                src="/src/assets/img/corpo-gem.png"
                                alt="Corporación Gilberto Echeverri Mejía"
                                loading="lazy"
                            />
                        </div>
                        <div
                            class="client-logo"
                            title="Ricaurte Rosso Seguros"
                            data-tooltip="Ricaurte Rosso Seguros"
                        >
                            <img
                                src="/src/assets/img/logo-c.jpg"
                                alt="Ricaurte Rosso Seguros"
                                loading="lazy"
                            />
                        </div>
                        <div
                            class="client-logo client-logo--dark"
                            title="BINAR10 CORP"
                            data-tooltip="BINAR10 CORP"
                        >
                            <img
                                src="/src/assets/img/binar.png"
                                alt="BINAR10 CORP"
                                loading="lazy"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ============ CONTACTO ============ -->
        <section class="section contact" id="contacto">
            <div class="contact__bg" aria-hidden="true">
                <div class="hero__grid"></div>
                <div class="blob blob--c"></div>
            </div>
            <div
                class="container contact__inner"
                style="
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    text-align: center;
                    max-width: 820px;
                "
            >
                <div
                    class="contact__copy reveal"
                    style="
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        width: 100%;
                    "
                >
                    <span class="eyebrow">Contacto</span>
                    <h2
                        style="
                            font-size: clamp(2.2rem, 4.5vw, 3.4rem);
                            font-weight: 800;
                            margin-bottom: 28px;
                            line-height: 1.15;
                        "
                    >
                        Impulsemos tu negocio <br />e identidad digital
                    </h2>

                    <div
                        class="contact__direct"
                        style="
                            justify-content: center;
                            gap: 16px;
                            margin-bottom: 44px;
                        "
                    >
                        <a
                            class="contact__chip"
                            id="waLink"
                            href="https://wa.me/573148316310"
                            target="_blank"
                            rel="noopener"
                            style="padding: 14px 28px; font-size: 1rem"
                        >
                            <svg
                                viewBox="-1 -1 26 26"
                                aria-hidden="true"
                                style="width: 20px; height: 20px; overflow: visible;"
                            >
                                <path
                                    d="M20.5 3.5A11 11 0 0 0 3.2 17.1L2 22l5-1.3A11 11 0 1 0 20.5 3.5z"
                                ></path>
                            </svg>
                            Escríbenos por WhatsApp
                        </a>
                        <a
                            class="contact__chip"
                            id="mailLink"
                            href="mailto:kgroupmed@gmail.com"
                            style="padding: 14px 28px; font-size: 1rem"
                        >
                            <svg
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                                style="width: 20px; height: 20px"
                            >
                                <rect
                                    x="2.5"
                                    y="4.5"
                                    width="19"
                                    height="15"
                                    rx="2.5"></rect>
                                <path d="M3 6l9 6 9-6"></path>
                            </svg>
                            <span id="mailText">kgroupmed@gmail.com</span>
                        </a>
                    </div>

                    <!-- Formulario Transparente con Logo en el Fondo -->
                    <div class="contact__form-wrapper">
                        <!-- Logo Marca de Agua de Fondo -->
                        <div class="contact__bg-logo" aria-hidden="true">
                            <svg class="mark" viewBox="534 609 1085 776">
                                <path
                                    fill="#ffffff"
                                    d="M1608.969,1068.419l-313.066,306.59l-0.017,-0.017l-190.126,0.017l-294.071,-306.668l0,0.291l-90.944,0l0,244.378l-58.093,61.748l-105.651,0l0,-672.737l58.88,-76.78l104.864,0l0,306.126l90.944,0l0,0.291l294.071,-306.668l189.183,-0l109.56,107.672l-70.987,63.358l-104.35,-103.69l-306.762,307.669l287.391,288.545l216.22,-220.209l-42.099,-41.747l-40.431,41.874l-24.878,0.06l0.023,-0.023l-138.72,0.008l-0.015,0.015l-19.503,-0.036l95.087,-95.903l0,-0.027l37.594,-38.105l179.755,-0l66.006,65.548l70.136,68.419Z"
                                ></path>
                                <path
                                    fill="#a796ff"
                                    d="M1082.986,947.544l52.456,52.456l-52.456,52.456l-52.456,-52.456l52.456,-52.456Z"
                                ></path>
                                <path
                                    fill="#a796ff"
                                    d="M810.748,969.531l-90.277,-0l0,60.938l90.277,0l0,-60.938Z"
                                ></path>
                            </svg>
                        </div>

                        <!-- Formulario Transparente Visible -->
                        <ContactForm />
                    </div>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>
