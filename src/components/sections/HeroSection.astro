<section class="hero">
    <div class="hero__bg" aria-hidden="true">
        <div class="hero__grid"></div>
        <div class="blob blob--a"></div>
        <div class="blob blob--b"></div>
    </div>

    <div class="container hero__inner">
        <div class="hero__copy">
            <h1 class="reveal" style="--d: 60ms">
                Soluciones de software a la medida <br />
                <em
                    style="
                        background: linear-gradient(
                            135deg,
                            #a796ff 0%,
                            #6c4ff6 100%
                        );
                        -webkit-background-clip: text;
                        background-clip: text;
                        color: transparent;
                    "
                    >que impulsan tu negocio</em
                >
            </h1>

            <div class="hero__actions reveal" style="--d: 180ms">
                <a class="btn btn--primary btn--lg" href="#contacto">
                    Contáctanos
                    <svg
                        viewBox="0 0 24 24"
                        class="btn__icon"
                        aria-hidden="true"
                    >
                        <path d="M5 12h14M13 6l6 6-6 6"></path>
                    </svg>
                </a>
            </div>
        </div>

        <!-- Mockup Visual -->
        <div class="hero__visual reveal" style="--d: 300ms" aria-hidden="true">
            <div class="mock mock--app">
                <div class="mock__bar">
                    <span class="dot"></span><span class="dot"></span><span
                        class="dot"></span>
                    <div class="mock__url">app.kgroup.co</div>
                </div>
                <div class="mock__body">
                    <div class="mock__side">
                        <span class="ln ln--active"></span><span class="ln"
                        ></span><span class="ln"></span>
                        <span class="ln"></span><span class="ln"></span>
                    </div>
                    <div class="mock__main">
                        <div class="mock__kpis">
                            <div class="kpi">
                                <small>Ventas</small><strong>$48.2M</strong><i
                                    class="up">+18%</i
                                >
                            </div>
                            <div class="kpi">
                                <small>Órdenes</small><strong>1.284</strong><i
                                    class="up">+7%</i
                                >
                            </div>
                            <div class="kpi">
                                <small>Ticket</small><strong>$37.5k</strong><i
                                    class="up">+4%</i
                                >
                            </div>
                        </div>
                        <div class="mock__chart">
                            <svg
                                viewBox="0 0 320 120"
                                preserveAspectRatio="none"
                            >
                                <defs>
                                    <linearGradient
                                        id="gfill"
                                        x1="0"
                                        y1="0"
                                        x2="0"
                                        y2="1"
                                    >
                                        <stop
                                            offset="0%"
                                            stop-color="#6C4FF6"
                                            stop-opacity=".45"></stop>
                                        <stop
                                            offset="100%"
                                            stop-color="#6C4FF6"
                                            stop-opacity="0"></stop>
                                    </linearGradient>
                                </defs>
                                <path
                                    class="chart-area"
                                    d="M0,95 L40,80 L80,88 L120,58 L160,66 L200,38 L240,45 L280,22 L320,30 L320,120 L0,120 Z"
                                    fill="url(#gfill)"></path>
                                <path
                                    class="chart-line"
                                    d="M0,95 L40,80 L80,88 L120,58 L160,66 L200,38 L240,45 L280,22 L320,30"
                                ></path>
                            </svg>
                        </div>
                        <div class="mock__rows">
                            <span></span><span></span><span></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mock mock--code">
                <div class="code-line">
                    <i class="c-key">deploy</i>
                    <i class="c-str">"produccion"</i>
                </div>
                <div class="code-line">
                    <i class="c-ok">✓</i> build 2.1s
                </div>
                <div class="code-line">
                    <i class="c-ok">✓</i> tests 128/128
                </div>
            </div>
        </div>
    </div>
</section>
